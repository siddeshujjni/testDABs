{
  "datasets": [
    {
      "displayName": "Top 10 Suppliers by Lead Time",
      "name": "top_suppliers_sql",
      "queryLines": [
        "SELECT\n",
        "  supplier_name,\n",
        "  avg_lead_time_days,\n",
        "  region,\n",
        "  country\n",
        "FROM\n",
        "  serverless_stable_qr9if1_catalog.scm_workshop.gold_supplier_lead_time\n",
        "ORDER BY\n",
        "  avg_lead_time_days DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "config": {
        "dimensions": [
          {
            "expr": "supplier_id",
            "name": "supplier_id"
          },
          {
            "expr": "supplier_name",
            "name": "supplier_name"
          },
          {
            "expr": "region",
            "name": "region"
          },
          {
            "expr": "country",
            "name": "country"
          }
        ],
        "measures": [
          {
            "expr": "AVG(avg_lead_time_days)",
            "name": "avg_lead_time"
          },
          {
            "expr": "SUM(num_orders)",
            "name": "num_orders"
          },
          {
            "expr": "SUM(total_spend)",
            "name": "total_spend"
          }
        ],
        "source": "serverless_stable_qr9if1_catalog.scm_workshop.gold_supplier_lead_time",
        "version": "1.1"
      },
      "displayName": "Supplier Metrics",
      "name": "supplier_metrics"
    },
    {
      "config": {
        "dimensions": [
          {
            "expr": "po_id",
            "name": "po_id"
          },
          {
            "expr": "supplier_id",
            "name": "supplier_id"
          },
          {
            "expr": "supplier_name",
            "name": "supplier_name"
          },
          {
            "expr": "product_category",
            "name": "product_category"
          },
          {
            "expr": "region",
            "name": "region"
          },
          {
            "expr": "country",
            "name": "country"
          },
          {
            "expr": "order_date",
            "name": "order_date"
          },
          {
            "expr": "DATE_TRUNC('month', order_date)",
            "name": "order_month"
          },
          {
            "expr": "received_date",
            "name": "received_date"
          },
          {
            "expr": "status",
            "name": "status"
          },
          {
            "expr": "quantity",
            "name": "quantity"
          },
          {
            "expr": "unit_cost",
            "name": "unit_cost"
          },
          {
            "expr": "total_cost",
            "name": "total_cost"
          },
          {
            "expr": "lead_time_days",
            "name": "lead_time_days"
          },
          {
            "expr": "is_delayed",
            "name": "is_delayed"
          },
          {
            "expr": "CASE WHEN is_delayed = 1 THEN 'Delayed' ELSE 'On Time' END",
            "name": "is_delayed_label"
          },
          {
            "expr": "delay_risk_score",
            "name": "delay_risk_score"
          },
          {
            "expr": "risk_category",
            "name": "risk_category"
          }
        ],
        "measures": [
          {
            "expr": "COUNT(*)",
            "name": "total_orders"
          },
          {
            "expr": "SUM(is_delayed)",
            "name": "delayed_orders"
          },
          {
            "expr": "MEASURE(delayed_orders) / MEASURE(total_orders)",
            "name": "delay_rate"
          }
        ],
        "source": "serverless_stable_qr9if1_catalog.scm_workshop.gold_po_delay_risk_scored",
        "version": "1.1"
      },
      "displayName": "PO Metrics",
      "name": "po_metrics"
    }
